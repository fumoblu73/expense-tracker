# Esempio di configurazione secrets
# Copia questo file in secrets.toml e inserisci le tue credenziali

[email]
sender = "tua-email@gmail.com"
password = "la-tua-password-app-gmail"

# Come ottenere la password app Gmail:
# 1. Vai su https://myaccount.google.com/
# 2. Sicurezza → Verifica in due passaggi (attivala se non lo è)
# 3. Sicurezza → Password per le app
# 4. Seleziona "Posta" e il tuo dispositivo
# 5. Copia la password generata (16 caratteri)
# 6. Incollala qui sopra sostituendo "la-tua-password-app-gmail"
